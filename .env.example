# ===================================================
# Eco-Loop Building Agents — Environment Configuration
# ===================================================
# Copy this file to .env and fill in your values.

# ------- EnergyPlus -------
# Path to EnergyPlus installation directory
ENERGYPLUS_DIR=/usr/local/EnergyPlus-24-1-0
# Set to "mock" to use synthetic simulation without EnergyPlus installed
SIMULATION_MODE=mock

# ------- Ollama LLM -------
OLLAMA_BASE_URL=http://localhost:11434
# Options: llama3, mistral, qwen2.5, llama3.2
LLM_MODEL=llama3

# ------- Database -------
DATABASE_PATH=./data/eco_loop.db

# ------- MCP Server -------
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ------- Dashboard -------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050

# ------- Output Paths -------
OUTPUT_DIR=./outputs
REPORTS_DIR=./outputs/reports
PLOTS_DIR=./outputs/plots

# ------- Bonus Features -------
# Carbon-aware optimization: use real-time carbon intensity API
CARBON_API_ENABLED=false
CARBON_API_KEY=

# Dynamic electricity pricing (TOU tariff)
DYNAMIC_PRICING_ENABLED=false

# Weather forecast integration
WEATHER_API_ENABLED=false
WEATHER_API_KEY=

# ------- Logging -------
LOG_LEVEL=INFO
LOG_FILE=./outputs/eco_loop.log
